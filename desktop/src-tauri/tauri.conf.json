{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blendermp",
  "version": "0.11.20",
  "identifier": "com.blendermp.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blendermp",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "devtools": false,
        "additionalBrowserArgs": "--disable-http-cache --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http: https:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
