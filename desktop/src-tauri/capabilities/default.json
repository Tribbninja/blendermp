{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-local-directory",
    "allow-discover-directories",
    "allow-detect-blender",
    "allow-launch-blender",
    "allow-find-blender-window",
    "allow-blender-running",
    "allow-embed-blender",
    "allow-set-embed-bounds",
    "allow-dock-looks-black",
    "allow-detach-blender",
    "allow-focus-blender",
    "allow-set-blender-visible",
    "allow-read-status",
    "allow-read-settings",
    "allow-write-settings",
    "allow-startup-flags",
    "allow-write-session",
    "allow-log-client"
  ]
}
